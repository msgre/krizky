# Google Drive
# Cesta k JSON souboru service accountu pro přístup ke Google Drive.
# Získáte ho v Google Cloud Console > IAM > Service Accounts > Keys.
GDRIVE_ACCOUNT_KEY=

# Cloudflare R2
# Account ID najdete na hlavní stránce Cloudflare dashboardu (pravý panel).
CF_ACCOUNT_ID=
# Access Key ID a Secret Access Key: R2 > Manage R2 API tokens.
CF_ACCESS_KEY_ID=
CF_SECRET_ACCESS_KEY=
